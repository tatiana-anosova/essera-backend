# Copy to .env and fill in. Never commit the filled-in file.

# Postgres connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/essera?schema=public

# Port the API listens on (defaults to 3001).
PORT=3001

# Supabase project used to verify bearer tokens.
SUPABASE_URL=https://your-project.supabase.co
# Optional: expected JWT audience (defaults to "authenticated").
SUPABASE_JWT_AUD=authenticated

# Stripe — Dashboard → Developers → API keys. Use the test key in development.
STRIPE_SECRET_KEY=<sk_test_... from the Stripe dashboard>
# Printed by `stripe listen --forward-to localhost:3001/checkout/stripe/webhook`,
# or Dashboard → Developers → Webhooks → your endpoint → signing secret.
STRIPE_WEBHOOK_SECRET=<whsec_... signing secret>

# Storefront origin Stripe returns the buyer to after checkout.
STOREFRONT_URL=http://localhost:3000
# Optional overrides for the return URLs; defaults are derived from STOREFRONT_URL.
# CHECKOUT_SUCCESS_URL=
# CHECKOUT_CANCEL_URL=
# Optional ISO currency for Checkout Sessions (defaults to usd).
# CHECKOUT_CURRENCY=usd
