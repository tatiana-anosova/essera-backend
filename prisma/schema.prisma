// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Lifecycle of a product: only ACTIVE ones are visible on the storefront
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Enum for product label
enum ProductLabel {
  new
  best
  sell
  empty // for ""
}

model Product {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  description   String?
  basePrice     Float
  discount      Int      @default(0)
  discountPrice Float?   // can be undefined/null
  label         ProductLabel @default(empty)
  status        ProductStatus @default(DRAFT)
  rating        Float?   // can be undefined/null
  reviewsCount  Int?     // can be undefined/null
  category      String?
  brand         String?
  variants      ProductVariant[]
  details       Detail[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  color     String
  colorHex  String?
  images    String[]
  sizes     ProductSize[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductSize {
  id         Int             @id @default(autoincrement())
  variantId  Int
  variant    ProductVariant  @relation(fields: [variantId], references: [id])
  size       String
  inStock    Boolean
  quantity   Int
}

// Payment state of an order. Fulfilment is deliberately not modelled yet.
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id                    String      @id @default(uuid())
  // Supabase user when the buyer is signed in; guest checkout leaves it null.
  userId                String?     @db.Uuid
  email                 String?
  status                OrderStatus @default(PENDING)
  currency              String      @default("usd")
  // Minor units (cents), as sent to and charged by Stripe.
  totalAmount           Int
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

// A purchase snapshot: everything needed to render the line later, even if the
// product is edited, archived or deleted afterwards.
model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  sizeId    Int?
  title     String
  variant   String
  size      String
  // Minor units (cents) actually charged for one unit.
  unitPrice Int
  quantity  Int

  @@index([orderId])
}

// Consumed Stripe event ids. The insert is the idempotency lock: a redelivered
// event hits the primary key and is acknowledged without being replayed.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Detail {
  id        Int      @id @default(autoincrement())
  key       String   // например, 'fabric', 'fit', 'shipping'
  title     String
  content   String
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model Profile {
  userId    String    @id @db.Uuid @map("user_id")
  firstName String?   @map("first_name")
  lastName  String?   @map("last_name")
  email     String?   @unique
  role      UserRole  @default(CUSTOMER)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("profiles")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id         String          @id @default(uuid())
  name       String
  email      String
  comment    String
  createdAt  DateTime        @default(now())
  ip         String?
  userAgent  String?
  status      ContactStatus  @default(NEW)

  @@index([createdAt(sort: Desc)])
}
